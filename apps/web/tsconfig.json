{
  "extends": "@rhumb/tsconfig/react.json",
  "compilerOptions": {
    "types": ["vite/client", "node"],
    "paths": {
      "@app/*": ["./src/app/*"],
      "@pages/*": ["./src/pages/*"],
      "@widgets/*": ["./src/widgets/*"],
      "@features/*": ["./src/features/*"],
      "@entities/*": ["./src/entities/*"],
      "@shared/*": ["./src/shared/*"]
    }
  },
  "include": ["src", "vite", "*.config.ts"]
}
