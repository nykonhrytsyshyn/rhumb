{
  "name": "rhumb",
  "version": "26.10.2",
  "description": "Standard-conforming flowcharts from Mermaid-like text",
  "author": "Nykon (https://nykon.me)",
  "license": "MIT",
  "homepage": "https://rhumb.nykon.me",
  "type": "module",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nykonhrytsyshyn/rhumb.git"
  },
  "bugs": {
    "url": "https://github.com/nykonhrytsyshyn/rhumb/issues",
    "email": "contact@nykon.me"
  },
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=22.16.0",
    "pnpm": ">=11.0.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^22.16.0 || ^24.0.0",
      "onFail": "warn"
    }
  },
  "scripts": {
    "dev": "pnpm --filter @rhumb/web dev",
    "staging": "pnpm --filter @rhumb/web staging",
    "build": "pnpm --filter @rhumb/web build",
    "preview": "pnpm --filter @rhumb/web preview",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run format:check && pnpm run test && pnpm run build",
    "typecheck": "pnpm --filter \"./packages/**\" --filter \"./apps/**\" run typecheck && tsc --noEmit",
    "lint": "eslint . && pnpm --filter @rhumb/web run lint:fsd",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:report": "vitest run --reporter=html",
    "test:preview": "vite preview --outDir .vitest",
    "test:ui": "vitest --ui",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "deps": "pnpm update --latest --recursive --interactive",
    "deps:check": "pnpm outdated --recursive",
    "tree": "treee -I \"node_modules|.git|.idea|target|build|dist|dev-dist|bin|.project-structure.txt\" -a --dirs-first",
    "tree:export": "pnpm run tree --silent > .project-structure.txt"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.5",
    "@vitest/ui": "^5.0.5",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jiti": "^2.7.0",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "prettier-plugin-yaml": "^1.3.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
