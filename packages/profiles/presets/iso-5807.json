{
  "id": "iso-5807",
  "title": "ISO 5807",
  "description": "Draft values, verify against the standard text.",
  "unit": "mm",
  "grid": 5,
  "padding": 1.5,
  "spacing": {
    "node": 10,
    "layer": 10
  },
  "line": {
    "width": 0.5,
    "thickWidth": 1,
    "dash": [3, 1.5],
    "arrow": {
      "style": "filled",
      "length": 3,
      "width": 1.6
    }
  },
  "font": {
    "family": "'Arial', 'Helvetica', sans-serif",
    "size": 3.5,
    "lineHeight": 1.3
  },
  "shapes": {
    "process": {
      "minWidth": 20,
      "minHeight": 10
    },
    "decision": {
      "minWidth": 20,
      "minHeight": 10
    },
    "terminator": {
      "minWidth": 20,
      "minHeight": 10
    },
    "io": {
      "minWidth": 20,
      "minHeight": 10
    },
    "preparation": {
      "minWidth": 20,
      "minHeight": 10
    },
    "predefinedProcess": {
      "minWidth": 20,
      "minHeight": 10
    },
    "connector": {
      "minWidth": 10,
      "minHeight": 10
    }
  },
  "decision": {
    "entry": "top",
    "yes": {
      "side": "bottom",
      "labels": ["yes", "y", "true", "да", "+"]
    },
    "no": {
      "side": "right",
      "labels": ["no", "n", "false", "нет", "-"]
    }
  },
  "loop": {
    "entry": "top",
    "body": "bottom",
    "back": "left",
    "exit": "right"
  }
}
